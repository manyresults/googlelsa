# Webhook that receives each lead (e.g. your Zapier catch hook)
WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/

# Google Ads API credentials
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Account that owns the LSA campaign, digits only (no dashes)
GOOGLE_ADS_CUSTOMER_ID=
# Only if you access it through a manager (MCC) account, digits only
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional
GOOGLE_ADS_API_VERSION=v22
COMPANY_NAME=
POLL_INTERVAL_MINUTES=15
LOOKBACK_HOURS=48
STATE_FILE=./data/state.json
